{
  "name": "@sysgraph/playground",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-proto": "mkdir -p proto && protoc --plugin=protoc-gen-es=./node_modules/.bin/protoc-gen-es --es_out=./proto --es_opt=target=ts,import_extension=js --proto_path=../proto/playground --proto_path=../ ../proto/playground/playground.proto",
    "build": "npm run generate-proto && tsc && vite build",
    "test": "wtr",
    "lint": "eslint .",
    "analyze": "lit-analyzer '**/*.ts'",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "lit": "^3.3.3",
    "safevalues": "^0.3.4"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@eslint/js": "^10.0.1",
    "@remcovaes/web-test-runner-vite-plugin": "^1.4.1",
    "@types/jasmine": "^6.0.0",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^1.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-lit": "^2.3.1",
    "lit-analyzer": "^2.0.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "web-test-runner-jasmine": "^0.2.0"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "@puppeteer/browsers": "^3.2.1"
  }
}
